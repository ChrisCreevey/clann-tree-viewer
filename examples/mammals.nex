#NEXUS

[ A small NEXUS example: nine mammals, a translate table, and two trees.
  The Clann tree viewer reads the TREES block, resolves the translate keys
  back to taxon names, and drops [&...] comments like the [&U] below. ]

begin taxa;
  dimensions ntax=9;
  taxlabels Human Chimp Gorilla Orangutan Macaque Mouse Rat Dog Cat;
end;

begin trees;
  translate
    1 Human,
    2 Chimp,
    3 Gorilla,
    4 Orangutan,
    5 Macaque,
    6 Mouse,
    7 Rat,
    8 Dog,
    9 Cat;
  tree nj = [&U] (((((1:0.375,2:0.375)98:0.490,3:0.260)85:0.463,5:0.375)72:0.213,4:0.238)90:0.888,((6:0.600,7:0.600)99:0.142,(8:1.000,9:1.000)97:1.258)80:0.500);
  tree alt = [&U] ((((1:0.38,2:0.38)95:0.49,(3:0.30,4:0.30)70:0.20)88:0.40,5:0.55)82:0.30,((6:0.60,7:0.60)99:0.14,(8:1.00,9:1.00)97:1.26)78:0.50);
end;
